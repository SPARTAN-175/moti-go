rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================
    // FUNCIONES DE AUTENTICACIÓN
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && userDoc().data.tipo == "admin";
    }

    function isBusiness() {
      return signedIn()
        && userDoc().data.tipo == "negocio";
    }


    // =====================================================
    // IMÁGENES DE PRODUCTOS
    // Ruta utilizada por MOTI GO:
    //
    // productos/{productoId}/imagen
    // =====================================================

    match /productos/{productoId}/imagen {

      // Las imágenes de productos pueden visualizarse
      // desde el catálogo.
      allow read: if true;


      // Administradores y negocios autenticados
      // pueden subir/reemplazar la imagen.
      //
      // Límites:
      // - máximo 2 MB
      // - JPEG
      // - PNG
      // - WebP
      //
      // Se permite crear la imagen aunque todavía no exista
      // el inventario, porque MOTI GO sube la imagen antes
      // de terminar de guardar el producto.
      allow write: if (
          isAdmin()
          || isBusiness()
        )
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );
    }




    // =====================================================
    // FOTOS DE PERFIL
    // =====================================================

    match /usuarios/{uid}/perfil/{archivo} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());

      allow write: if signedIn()
        && (uid == request.auth.uid || isAdmin())
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if signedIn() && (uid == request.auth.uid || isAdmin());
    }

    // =====================================================
    // DOCUMENTOS DE REPARTIDORES
    // =====================================================

    match /repartidores/{uid}/documentos/{archivo} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());

      allow write: if signedIn()
        && (uid == request.auth.uid || isAdmin())
        && request.resource.size <= 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );

      allow delete: if signedIn() && (uid == request.auth.uid || isAdmin());
    }

    // =====================================================
    // LOGO / FOTO DE TIENDA
    // Ruta usada por el perfil del negocio:
    // tiendas/{tiendaId}/logo/perfil
    // =====================================================

    match /tiendas/{tiendaId}/logo/{archivo} {
      allow read: if true;

      allow write: if (
          isAdmin()
          || (isBusiness() && userDoc().data.tiendaId == tiendaId)
        )
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isAdmin()
        || (isBusiness() && userDoc().data.tiendaId == tiendaId);
    }

    // =====================================================
    // DOCUMENTOS DE TIENDAS
    // =====================================================

    match /tiendas/{tiendaId}/documentos/{archivo} {
      allow read: if isAdmin()
        || (isBusiness() && userDoc().data.tiendaId == tiendaId);

      allow write: if (
          isAdmin()
          || (isBusiness() && userDoc().data.tiendaId == tiendaId)
        )
        && request.resource.size <= 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );

      allow delete: if isAdmin()
        || (isBusiness() && userDoc().data.tiendaId == tiendaId);
    }

    // =====================================================
    // TODO LO DEMÁS QUEDA BLOQUEADO
    // =====================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}